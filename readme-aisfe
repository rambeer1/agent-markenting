import { CommonModule } from '@angular/common';
import { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';
import { CONTENT_TYPES, ContentGenerateResponse, ContentService } from '../../services/content.service';

interface HistoryEntry {
  course: string;
  topic: string;
  targetAudience: string;
  content_type: string;
  response: ContentGenerateResponse;
}

@Component({
  selector: 'app-content-generate',
  standalone: true,
  imports: [CommonModule, ReactiveFormsModule],
  templateUrl: './content-generate.component.html',
})
export class ContentGenerateComponent {
  private readonly fb = inject(FormBuilder);
  private readonly contentService = inject(ContentService);

  readonly contentTypes = CONTENT_TYPES;
  loading = false;
  error: string | null = null;
  history: HistoryEntry[] = [];

  readonly form = this.fb.nonNullable.group({
    course: ['', Validators.required],
    topic: ['', Validators.required],
    targetAudience: ['', Validators.required],
    content_type: ['Article', Validators.required],
  });

  submit(): void {
    if (this.form.invalid) {
      this.form.markAllAsTouched();
      return;
    }
    this.loading = true;
    this.error = null;
    const payload = this.form.getRawValue();
    this.contentService.generate(payload).subscribe({
      next: (response) => {
        this.loading = false;
        this.history.unshift({ ...payload, response });
      },
      error: () => {
        this.loading = false;
        this.error = 'Content generation failed. Please try again.';
      },
    });
  }
}

