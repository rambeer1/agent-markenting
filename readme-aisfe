import { Component, OnInit, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormBuilder, FormsModule, ReactiveFormsModule, Validators } from '@angular/forms';
import { AuthService } from '../../services/auth.service';
import {
  LEAD_ACTIVITY_TYPES,
  LEAD_SOURCES,
  LEAD_STATUSES,
  Lead,
  LeadActivity,
  LeadScore,
  LeadService,
} from '../../services/lead.service';

@Component({
  selector: 'app-leads-list',
  standalone: true,
  imports: [CommonModule, FormsModule, ReactiveFormsModule],
  templateUrl: './leads-list.component.html',
})
export class LeadsListComponent implements OnInit {
  private readonly fb = inject(FormBuilder);
  private readonly leadService = inject(LeadService);
  readonly auth = inject(AuthService);

  readonly sources = LEAD_SOURCES;
  readonly statuses = LEAD_STATUSES;
  readonly activityTypes = LEAD_ACTIVITY_TYPES;

  leads: Lead[] = [];
  loading = false;
  error: string | null = null;

  searchText = '';
  statusFilter = '';
  sourceFilter = '';

  showCreateForm = false;
  selectedLead: Lead | null = null;
  timeline: LeadActivity[] = [];
  score: LeadScore | null = null;

  readonly createForm = this.fb.nonNullable.group({
    first_name: ['', Validators.required],
    last_name: [''],
    mobile: ['', Validators.required],
    email: [''],
    city: [''],
    state: [''],
    course_interest: [''],
    source: [this.sources[0], Validators.required],
  });

  readonly updateForm = this.fb.nonNullable.group({
    status: ['NEW'],
    assigned_to: [0],
    course_interest: [''],
  });

  readonly activityForm = this.fb.nonNullable.group({
    activity_type: [this.activityTypes[0], Validators.required],
    remarks: [''],
  });

  ngOnInit(): void {
    this.refresh();
  }

  canManage(): boolean {
    return this.auth.hasRole('ADMIN', 'MARKETING_MANAGER', 'COUNSELOR');
  }

  refresh(): void {
    this.loading = true;
    this.leadService.list().subscribe({
      next: (data) => {
        this.leads = data;
        this.loading = false;
      },
      error: () => {
        this.error = 'Unable to load leads.';
        this.loading = false;
      },
    });
  }

  filteredLeads(): Lead[] {
    const search = this.searchText.trim().toLowerCase();
    return this.leads.filter((lead) => {
      const matchesSearch =
        !search ||
        `${lead.first_name} ${lead.last_name ?? ''}`.toLowerCase().includes(search) ||
        lead.mobile.includes(search) ||
        (lead.email ?? '').toLowerCase().includes(search);
      const matchesStatus = !this.statusFilter || lead.status === this.statusFilter;
      const matchesSource = !this.sourceFilter || lead.source === this.sourceFilter;
      return matchesSearch && matchesStatus && matchesSource;
    });
  }

  scoreBand(score: number): string {
    if (score <= 30) return 'Cold';
    if (score <= 60) return 'Warm';
    return 'Hot';
  }

  openCreateForm(): void {
    this.createForm.reset({
      first_name: '',
      last_name: '',
      mobile: '',
      email: '',
      city: '',
      state: '',
      course_interest: '',
      source: this.sources[0],
    });
    this.showCreateForm = true;
  }

  createLead(): void {
    if (this.createForm.invalid) {
      this.createForm.markAllAsTouched();
      return;
    }
    this.leadService.create(this.createForm.getRawValue()).subscribe({
      next: () => {
        this.showCreateForm = false;
        this.refresh();
      },
      error: () => (this.error = 'Unable to create lead.'),
    });
  }

  select(lead: Lead): void {
    this.selectedLead = lead;
    this.updateForm.setValue({
      status: lead.status,
      assigned_to: lead.assigned_to ?? 0,
      course_interest: lead.course_interest ?? '',
    });
    this.activityForm.reset({ activity_type: this.activityTypes[0], remarks: '' });
    this.loadTimeline(lead.lead_id);
    this.loadScore(lead.lead_id);
  }

  closeDetail(): void {
    this.selectedLead = null;
    this.timeline = [];
    this.score = null;
  }

  private loadTimeline(leadId: number): void {
    this.leadService.getTimeline(leadId).subscribe({ next: (data) => (this.timeline = data) });
  }

  private loadScore(leadId: number): void {
    this.leadService.getScore(leadId).subscribe({ next: (data) => (this.score = data) });
  }

  saveUpdate(): void {
    if (!this.selectedLead) {
      return;
    }
    this.leadService.update(this.selectedLead.lead_id, this.updateForm.getRawValue()).subscribe({
      next: (updated) => {
        this.selectedLead = updated;
        this.refresh();
      },
      error: () => (this.error = 'Unable to update lead.'),
    });
  }

  addActivity(): void {
    if (!this.selectedLead || this.activityForm.invalid) {
      this.activityForm.markAllAsTouched();
      return;
    }
    const leadId = this.selectedLead.lead_id;
    this.leadService.addActivity(leadId, this.activityForm.getRawValue()).subscribe({
      next: () => {
        this.activityForm.reset({ activity_type: this.activityTypes[0], remarks: '' });
        this.loadTimeline(leadId);
        this.loadScore(leadId);
        this.refresh();
      },
      error: () => (this.error = 'Unable to add activity.'),
    });
  }
}

