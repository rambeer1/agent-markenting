from datetime import datetime, timedelta, timezone

from fastapi import APIRouter, Depends, Query
from fastapi.responses import Response
from sqlalchemy import func
from sqlalchemy.orm import Session

from app.database import get_db
from app.exceptions import ApiError, ResourceNotFoundException, success_response
from app.models import LEAD_STATUS_FUNNEL, ConsultationRequest
from app.schemas import ConsultationRequestDto, DashboardStatsDto, UpdateStatusDto
from app.security import require_roles

router = APIRouter(prefix="/consultation", tags=["consultation"])


def _dto(o: ConsultationRequest) -> dict:
    return {
        "id": o.id,
        "referenceNumber": o.reference_number,
        "organizationName": o.organization_name,
        "contactPerson": o.contact_person,
        "mobile": o.mobile,
        "email": o.email,
        "industry": o.industry,
        "organizationSize": o.organization_size,
        "requirements": o.requirements,
        "preferredEngagementStep": o.preferred_engagement_step,
        "status": o.status,
        "internalRemarks": o.internal_remarks,
        "createdDate": o.created_date.isoformat() if o.created_date else None,
    }


def _generate_reference_number(db: Session) -> str:
    # BR-1: globally unique reference number, format AIS-YYYYMMDD-NNNN.
    today = datetime.now(timezone.utc).strftime("%Y%m%d")
    prefix = f"AIS-{today}-"
    count_today = (
        db.query(ConsultationRequest)
        .filter(ConsultationRequest.reference_number.like(f"{prefix}%"))
        .count()
    )
    return f"{prefix}{count_today + 1:04d}"


@router.post("/requests", status_code=201)
def submit_request(body: ConsultationRequestDto, db: Session = Depends(get_db)):
    entity = ConsultationRequest(
        reference_number=_generate_reference_number(db),
        organization_name=body.organizationName,
        contact_person=body.contactPerson,
        mobile=body.mobile,
        email=body.email,
        industry=body.industry,
        organization_size=body.organizationSize,
        requirements=body.requirements,
        preferred_engagement_step=body.preferredEngagementStep,
        status="NEW",
    )
    db.add(entity)
    db.commit()
    db.refresh(entity)
    return success_response(_dto(entity))


@router.get("/requests")
def list_requests(
    page: int = Query(default=0, ge=0),
    size: int = Query(default=10, ge=1, le=100),
    industry: str | None = Query(default=None),
    status: str | None = Query(default=None),
    db: Session = Depends(get_db),
    user: dict = Depends(require_roles("ADMIN", "EDITOR")),
):
    q = db.query(ConsultationRequest)
    if industry:
        q = q.filter(ConsultationRequest.industry == industry)
    if status:
        q = q.filter(ConsultationRequest.status == status)
    q = q.order_by(ConsultationRequest.created_date.desc())
    total = q.count()
    items = q.offset(page * size).limit(size).all()
    return success_response({
        "content": [_dto(i) for i in items],
        "totalElements": total,
        "totalPages": math.ceil(total / size) if size else 0,
        "page": page,
        "size": size,
    })


# NOTE: static sub-paths (/export, /dashboard/stats) must be routed before the
# dynamic "/{item_id}" path below, or FastAPI will try to parse them as an id.
@router.get("/requests/export")
def export_requests_csv(db: Session = Depends(get_db),
                         user: dict = Depends(require_roles("ADMIN", "EDITOR"))):
    items = db.query(ConsultationRequest).order_by(ConsultationRequest.created_date.desc()).all()
    buffer = io.StringIO()
    writer = csv.writer(buffer)
    writer.writerow([
        "id", "reference_number", "organization_name", "contact_person", "mobile", "email",
        "industry", "organization_size", "requirements", "preferred_engagement_step", "status",
        "internal_remarks", "created_date",
    ])
    for o in items:
        writer.writerow([
            o.id, o.reference_number, o.organization_name, o.contact_person, o.mobile, o.email,
            o.industry, o.organization_size, o.requirements, o.preferred_engagement_step,
            o.status, o.internal_remarks, o.created_date.isoformat() if o.created_date else "",
        ])
    return Response(
        content=buffer.getvalue(),
        media_type="text/csv",
        headers={"Content-Disposition": "attachment; filename=consultation-requests.csv"},
    )


@router.get("/dashboard/stats")
def dashboard_stats(db: Session = Depends(get_db),
                     user: dict = Depends(require_roles("ADMIN", "EDITOR"))):
    total = db.query(ConsultationRequest).count()
    cutoff = datetime.now(timezone.utc) - timedelta(days=30)
    recent = db.query(ConsultationRequest).filter(ConsultationRequest.created_date >= cutoff).count()
    by_industry = dict(
        db.query(ConsultationRequest.industry, func.count(ConsultationRequest.id))
        .group_by(ConsultationRequest.industry).all()
    )
    by_status = dict(
        db.query(ConsultationRequest.status, func.count(ConsultationRequest.id))
        .group_by(ConsultationRequest.status).all()
    )
    return success_response(DashboardStatsDto(
        totalRequests=total, newRequestsLast30Days=recent,
        requestsByIndustry=by_industry, requestsByStatus=by_status,
    ).model_dump())


@router.get("/requests/{item_id}")
def get_request(item_id: int, db: Session = Depends(get_db),
                 user: dict = Depends(require_roles("ADMIN", "EDITOR"))):
    entity = db.query(ConsultationRequest).get(item_id)
    if not entity:
        raise ResourceNotFoundException(f"Consultation request with id {item_id} not found")
    return success_response(_dto(entity))


@router.patch("/requests/{item_id}/status")
def update_status(item_id: int, body: UpdateStatusDto, db: Session = Depends(get_db),
                   user: dict = Depends(require_roles("ADMIN", "EDITOR"))):
    entity = db.query(ConsultationRequest).get(item_id)
    if not entity:
        raise ResourceNotFoundException(f"Consultation request with id {item_id} not found")

    # BR-2: forward-only funnel progression; moving backward requires ROLE_ADMIN + a remark.
    current_index = LEAD_STATUS_FUNNEL.index(entity.status)
    new_index = LEAD_STATUS_FUNNEL.index(body.status)
    if new_index < current_index:
        if "ROLE_ADMIN" not in user["roles"]:
            raise ApiError(403, "FORBIDDEN", "Only an Admin may move a lead backward in the funnel")
        if not body.internalRemarks:
            raise ApiError(400, "VALIDATION_FAILED", "A remark is required to move a lead backward",
                            ["internalRemarks: required when moving status backward"])

    entity.status = body.status
    if body.internalRemarks is not None:
        entity.internal_remarks = body.internalRemarks
    db.commit()
    db.refresh(entity)
    return success_response(_dto(entity))

