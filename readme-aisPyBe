  if (method === 'GET' && path === '/consultation/requests/export') {
    const header = 'id,reference_number,organization_name,contact_person,mobile,email,industry,organization_size,requirements,preferred_engagement_step,status,internal_remarks,created_date';
    const rows = mockConsultationRequests.map((r) =>
