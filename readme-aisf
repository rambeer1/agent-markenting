  constructor(private readonly http: HttpClient) {}

  submit(request: ConsultationRequest): Observable<ConsultationResponse> {
    return this.http
      .post<ApiResponse<ConsultationResponse>>(`${this.baseUrl}/requests`, request)
      .pipe(map((r) => r.data));
  }

  list(
    page = 0,
    size = 10,
    industry?: string,
    status?: LeadStatus,
