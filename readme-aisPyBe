from datetime import datetime, timedelta, timezone

from fastapi import Depends, Header
from jose import JWTError, jwt
from passlib.context import CryptContext

from app.config import settings
from app.exceptions import ApiError

pwd_context = CryptContext(schemes=["bcrypt"], deprecated="auto")

ALGORITHM = "HS256"


def verify_password(plain_password: str, hashed_password: str) -> bool:
    return pwd_context.verify(plain_password, hashed_password)


def _create_token(username: str, role: str, token_type: str, expires_in_ms: int) -> str:
    now = datetime.now(timezone.utc)
    expire = now + timedelta(milliseconds=expires_in_ms)
    payload = {
        "sub": username,
        "roles": [f"ROLE_{role}"],
        "type": token_type,
        "iat": int(now.timestamp()),
        "exp": expire,
    }
    return jwt.encode(payload, settings.jwt_secret, algorithm=ALGORITHM)


def create_access_token(username: str, role: str) -> str:
    return _create_token(username, role, "access", settings.access_token_expiration_ms)


def create_refresh_token(username: str, role: str) -> str:
    return _create_token(username, role, "refresh", settings.refresh_token_expiration_ms)


def decode_token(token: str, expected_type: str) -> dict:
    try:
        payload = jwt.decode(token, settings.jwt_secret, algorithms=[ALGORITHM])
    except JWTError:
        raise ApiError(401, "INVALID_TOKEN", "Invalid or expired token")
    if payload.get("type") != expected_type:
        raise ApiError(401, "INVALID_TOKEN", "Invalid or expired token")
    return payload


def get_current_user(authorization: str | None = Header(default=None)) -> dict:
    if not authorization or not authorization.lower().startswith("bearer "):
        raise ApiError(401, "UNAUTHORIZED", "Missing or invalid Authorization header")
    token = authorization.split(" ", 1)[1]
    payload = decode_token(token, "access")
    return {"username": payload["sub"], "roles": payload.get("roles", [])}


def require_roles(*roles: str):
    """FastAPI dependency mirroring @PreAuthorize("hasAnyRole(...)")."""
    allowed = {f"ROLE_{r}" for r in roles}

    def _check(user: dict = Depends(get_current_user)) -> dict:
        if not allowed.intersection(user["roles"]):
            raise ApiError(403, "FORBIDDEN", "You do not have permission to perform this action")
        return user

    return _check

