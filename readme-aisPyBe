    let items = mockConsultationRequests;
    if (industry) items = items.filter((r) => r.industry === industry);
    if (status) items = items.filter((r) => r.status === status);
    return ok(paged(items, req));
  }
  if (method === 'GET' && /^\/consultation\/requests\/\d+$/.test(path)) {
