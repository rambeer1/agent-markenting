#!/bin/sh
# Starts all 4 Spring Boot services on localhost, waits for the gateway to become
# ready, then runs nginx in the foreground (the process Cloud Run actually monitors)
# listening on Cloud Run's $PORT and reverse-proxying /api/ to the gateway.
#
# Trade-off worth knowing: this script does not restart an individual JVM if it
# crashes after startup - only a whole-container restart (e.g. a new Cloud Run
# revision, or Cloud Run replacing an unhealthy instance) would recover it. Fine for a
# low-traffic marketing site; ask for a supervisor (e.g. tini + a watchdog loop) if you
# need per-process auto-restart.
set -e

echo "Starting ais-auth-service..."
SPRING_PROFILES_ACTIVE=gcp \
  DB_URL="$AUTH_DB_URL" DB_USERNAME="$AUTH_DB_USERNAME" DB_PASSWORD="$AUTH_DB_PASSWORD" \
  JWT_SECRET="$JWT_SECRET" \
  java -jar /app/auth-service.jar &

echo "Starting ais-content-service..."
SPRING_PROFILES_ACTIVE=gcp \
  DB_URL="$CONTENT_DB_URL" DB_USERNAME="$CONTENT_DB_USERNAME" DB_PASSWORD="$CONTENT_DB_PASSWORD" \
  JWT_SECRET="$JWT_SECRET" \
  java -jar /app/content-service.jar &

echo "Starting ais-consultation-service..."
SPRING_PROFILES_ACTIVE=gcp \
  DB_URL="$CONSULTATION_DB_URL" DB_USERNAME="$CONSULTATION_DB_USERNAME" DB_PASSWORD="$CONSULTATION_DB_PASSWORD" \
  JWT_SECRET="$JWT_SECRET" \
  java -jar /app/consultation-service.jar &

echo "Starting ais-gateway-service..."
# Deliberately NOT setting SPRING_PROFILES_ACTIVE=gcp here: the gateway's base
# application.yml already defaults AUTH_SERVICE_URI/CONTENT_SERVICE_URI/
# CONSULTATION_SERVICE_URI to http://localhost:8081/8083/8082 - exactly right for this
# single-container layout - so no route env vars need to be set at all.
JWT_SECRET="$JWT_SECRET" CORS_ALLOWED_ORIGINS="${CORS_ALLOWED_ORIGINS:-*}" \
  java -jar /app/gateway-service.jar &

echo "Waiting for the gateway to become ready..."
for i in $(seq 1 90); do
  if wget -q -O /dev/null http://127.0.0.1:8080/actuator/health 2>/dev/null; then
    echo "Gateway is up after ${i}s."
    break
  fi
  sleep 1
done

export PORT="${PORT:-8080}"
envsubst '${PORT}' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf
exec nginx -g 'daemon off;'

