<#
.SYNOPSIS
  Builds the single all-in-one container (Dockerfile.cloudrun) and deploys it as ONE
  Cloud Run service containing the frontend + gateway + auth + content + consultation,
  connected to the Cloud SQL instance created by setup-cloud-sql.ps1.

.NOTES
  Run setup-cloud-sql.ps1 once first and note the connection name it prints.
  Requires gcloud CLI authenticated. Docker not required locally - Cloud Build builds
  remotely from source using Dockerfile.cloudrun.
#>

param(
    [Parameter(Mandatory = $true)][string]$ProjectId,
    [Parameter(Mandatory = $true)][string]$CloudSqlConnectionName, # PROJECT:REGION:INSTANCE
    [string]$Region = "us-central1",
    [string]$Repo = "ais-images",
    [string]$ServiceName = "ais-website",
    [string]$DbName = "ais_db"
)

$ErrorActionPreference = "Stop"
gcloud config set project $ProjectId | Out-Null

$registry = "$Region-docker.pkg.dev/$ProjectId/$Repo"
$image = "$registry/${ServiceName}:latest"

$repoExists = gcloud artifacts repositories describe $Repo --location=$Region --format="value(name)" 2>$null
if (-not $repoExists) {
    gcloud artifacts repositories create $Repo --repository-format=docker --location=$Region
}

function Build-SocketFactoryUrl {
    param([string]$Db)
    return "jdbc:postgresql:///$Db" +
           "?cloudSqlInstance=$CloudSqlConnectionName" +
           "&socketFactory=com.google.cloud.sql.postgres.SocketFactory" +
           "&ipTypes=PUBLIC"
}
$dbUrl = Build-SocketFactoryUrl -Db $DbName

Write-Host "Building $image (this can take a few minutes: 4 Maven modules + Angular)..." -ForegroundColor Cyan
$buildConfig = New-TemporaryFile
@"
steps:
  - name: 'gcr.io/cloud-builders/docker'
    args: ['build', '-f', 'Dockerfile.cloudrun', '-t', '$image', '.']
images: ['$image']
options:
  machineType: 'E2_HIGHCPU_8'
timeout: '1800s'
"@ | Set-Content -Path $buildConfig -Encoding utf8
gcloud builds submit . --config=$buildConfig
Remove-Item $buildConfig -ErrorAction SilentlyContinue

Write-Host "Deploying $ServiceName ..." -ForegroundColor Cyan
gcloud run deploy $ServiceName `
    --image=$image `
    --region=$Region `
    --platform=managed `
    --port=8080 `
    --cpu=2 `
    --memory=2Gi `
    --cpu-boost `
    --timeout=300 `
    --min-instances=0 `
    --max-instances=3 `
    --add-cloudsql-instances=$CloudSqlConnectionName `
    --set-env-vars="AUTH_DB_URL=$dbUrl,AUTH_DB_USERNAME=ais_auth_user,CONTENT_DB_URL=$dbUrl,CONTENT_DB_USERNAME=ais_content_user,CONSULTATION_DB_URL=$dbUrl,CONSULTATION_DB_USERNAME=ais_consultation_user,CORS_ALLOWED_ORIGINS=*" `
    --set-secrets="AUTH_DB_PASSWORD=ais-auth-db-password:latest,CONTENT_DB_PASSWORD=ais-content-db-password:latest,CONSULTATION_DB_PASSWORD=ais-consultation-db-password:latest,JWT_SECRET=ais-jwt-secret:latest" `
    --allow-unauthenticated `
    --ingress=all

$serviceUrl = gcloud run services describe $ServiceName --region=$Region --format="value(status.url)"
Write-Host ""
Write-Host "Deployed: $serviceUrl" -ForegroundColor Green
Write-Host "Optional hardening: once you have a custom domain (or are happy using this" -ForegroundColor Yellow
Write-Host "*.run.app URL), tighten CORS to it instead of '*':" -ForegroundColor Yellow
Write-Host "  gcloud run services update $ServiceName --region=$Region --update-env-vars=CORS_ALLOWED_ORIGINS=$serviceUrl" -ForegroundColor Yellow

