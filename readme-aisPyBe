from fastapi import APIRouter, Depends
from sqlalchemy.orm import Session

from app.database import get_db
from app.exceptions import InvalidCredentialsException, success_response
from app.models import User
from app.schemas import LoginRequest, LoginResponse, RefreshRequest
from app.security import create_access_token, create_refresh_token, decode_token, verify_password
from app.config import settings

router = APIRouter(prefix="/auth", tags=["auth"])


def _login_response(user: User) -> dict:
    return LoginResponse(
        accessToken=create_access_token(user.username, user.role),
        refreshToken=create_refresh_token(user.username, user.role),
        username=user.username,
        role=user.role,
        expiresInMs=settings.access_token_expiration_ms,
    ).model_dump()


@router.post("/login")
def login(request: LoginRequest, db: Session = Depends(get_db)):
    user = db.query(User).filter(User.username == request.username).first()
    # Deliberately identical error for unknown username vs wrong password (FR-10).
    if not user or user.status != "ACTIVE" or not verify_password(request.password, user.password):
        raise InvalidCredentialsException()
    return success_response(_login_response(user))


@router.post("/refresh")
def refresh(request: RefreshRequest, db: Session = Depends(get_db)):
    payload = decode_token(request.refreshToken, "refresh")
    user = db.query(User).filter(User.username == payload["sub"]).first()
    if not user or user.status != "ACTIVE":
        raise InvalidCredentialsException()
    return success_response(_login_response(user))


@router.post("/logout")
def logout():
    # Stateless JWTs - client just discards the tokens.
    return success_response(None)
