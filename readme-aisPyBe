@Component({
  selector: 'app-consultation',
  standalone: true,
  imports: [ReactiveFormsModule],
  templateUrl: './consultation.html',
})
export class Consultation {
  private readonly fb = inject(FormBuilder);
  private readonly consultationService = inject(ConsultationService);

  readonly submitting = signal(false);
  readonly referenceNumber = signal<string | null>(null);

  readonly industries = ['College', 'School', 'Factory', 'Shopping Mall', 'Other'];
  readonly engagementSteps = ['Design Only', 'Full End-to-End', 'Custom'];

  readonly form = this.fb.group({
    organizationName: ['', [Validators.required]],
    contactPerson: ['', [Validators.required]],
    mobile: ['', [Validators.required, Validators.pattern(/^\+?[0-9]{7,15}$/)]],
    email: ['', [Validators.required, Validators.email]],
    industry: ['', [Validators.required]],
    organizationSize: [''],
    requirements: [''],
    preferredEngagementStep: [''],
  });

  submit(): void {
    if (this.form.invalid) {
      this.form.markAllAsTouched();
      return;
    }

    this.submitting.set(true);
    this.consultationService.submit(this.form.getRawValue() as any).subscribe({
      next: (response) => {
        this.submitting.set(false);
        this.referenceNumber.set(response.referenceNumber);
        this.form.reset();
      },
      error: () => this.submitting.set(false),
    });
  }
}

