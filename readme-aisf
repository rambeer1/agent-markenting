    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Everything under /api/ goes to the gateway process running on localhost inside
    # this same container - the gateway then talks to auth/content/consultation, also
    # on localhost. No other Cloud Run service is involved.
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~* \.(?:css|js|map|jpe?g|gif|png|svg|ico|woff2?)$ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    # Angular client-side routing: serve index.html for any unmatched path.
    location / {
        try_files $uri $uri/ /index.html;
    }
}






