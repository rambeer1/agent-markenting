  readonly auth = inject(AuthService);
  private readonly router = inject(Router);

  readonly navItems: NavItem[] = [
    { path: '/dashboard', label: 'Dashboard', roles: [] },
    { path: '/courses', label: 'Courses', roles: [] },
    { path: '/content', label: 'Content Agent', roles: ['ADMIN', 'MARKETING_MANAGER', 'CONTENT_REVIEWER'] },
    { path: '/seo', label: 'SEO Agent', roles: ['ADMIN', 'MARKETING_MANAGER', 'CONTENT_REVIEWER'] },
    { path: '/social', label: 'Social Agent', roles: ['ADMIN', 'MARKETING_MANAGER', 'CONTENT_REVIEWER'] },
    { path: '/campaigns', label: 'Campaigns', roles: [] },
    { path: '/leads', label: 'Leads', roles: [] },
    { path: '/analytics', label: 'Analytics', roles: [] },
  ];

  visibleNavItems(): NavItem[] {
    return this.navItems.filter((item) => item.roles.length === 0 || this.auth.hasRole(...item.roles));
  }

  logout(): void {
    this.auth.logout();
    this.router.navigate(['/login']);
  }
}

