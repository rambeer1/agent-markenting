import { HttpErrorResponse, HttpInterceptorFn } from '@angular/common/http';
import { inject } from '@angular/core';
import { Router } from '@angular/router';
import { catchError, throwError } from 'rxjs';
import { ApiErrorResponse } from '../models/api-response.model';
import { AuthService } from '../services/auth.service';
import { NotificationService } from '../services/notification.service';

/**
 * Functional interceptor (Angular 20 style) that unwraps the ApiErrorResponse envelope
 * (see ais_website_instructions.md Section 4B) and surfaces a user-friendly message.
 */
export const errorInterceptor: HttpInterceptorFn = (req, next) => {
  const notificationService = inject(NotificationService);
  const authService = inject(AuthService);
  const router = inject(Router);

  return next(req).pipe(
    catchError((error: HttpErrorResponse) => {
      const apiError = error.error as ApiErrorResponse | undefined;
      const message = apiError?.message ?? 'Something went wrong. Please try again.';
      const details = apiError?.details?.length ? ` (${apiError.details.join(', ')})` : '';

      if (error.status === 401) {
        notificationService.show('Your session has expired. Please log in again.', 'error');
        if (authService.isAuthenticated()) {
          authService.logout();
        } else {
          router.navigate(['/login']);
        }
      } else {
        notificationService.show(`${message}${details}`, 'error');
      }

      return throwError(() => error);
    }),
  );
};

