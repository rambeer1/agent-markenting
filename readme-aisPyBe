from datetime import datetime, timezone

from fastapi import FastAPI, Request
from fastapi.encoders import jsonable_encoder
from fastapi.exceptions import RequestValidationError
from fastapi.responses import JSONResponse


class ApiError(Exception):
    """Raised for any handled business error; mirrors the Java services' ApiErrorResponse."""

    def __init__(self, status_code: int, error_code: str, message: str, details: list[str] | None = None):
        self.status_code = status_code
        self.error_code = error_code
        self.message = message
        self.details = details or []


class ResourceNotFoundException(ApiError):
    def __init__(self, message: str):
        super().__init__(404, "RESOURCE_NOT_FOUND", message)


class DuplicateResourceException(ApiError):
    def __init__(self, message: str):
        super().__init__(409, "DUPLICATE_RESOURCE", message)


class InvalidCredentialsException(ApiError):
    def __init__(self):
        super().__init__(401, "INVALID_CREDENTIALS", "Invalid username or password")


def _error_body(error_code: str, message: str, details: list[str]) -> dict:
    return {
        "success": False,
        "errorCode": error_code,
        "message": message,
        "details": details,
        "timestamp": datetime.now(timezone.utc).isoformat(),
    }


def register_exception_handlers(app: FastAPI) -> None:
    @app.exception_handler(ApiError)
    async def handle_api_error(request: Request, exc: ApiError):
        return JSONResponse(
            status_code=exc.status_code,
            content=_error_body(exc.error_code, exc.message, exc.details),
        )

    @app.exception_handler(RequestValidationError)
    async def handle_validation_error(request: Request, exc: RequestValidationError):
        details = [
            f"{'.'.join(str(p) for p in err['loc'] if p != 'body')}: {err['msg']}"
            for err in exc.errors()
        ]
        return JSONResponse(
            status_code=400,
            content=_error_body("VALIDATION_FAILED", "Request validation failed", details),
        )

    @app.exception_handler(Exception)
    async def handle_unexpected_error(request: Request, exc: Exception):
        return JSONResponse(
            status_code=500,
            content=_error_body("INTERNAL_ERROR", "An unexpected error occurred", []),
        )


def success_response(data=None, message: str | None = None) -> dict:
    return jsonable_encoder(
        {
            "success": True,
            "data": data,
            "message": message,
            "timestamp": datetime.now(timezone.utc).isoformat(),
        }
    )

