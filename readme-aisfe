import { AuthService } from '../../services/auth.service';
import { Course, CourseService } from '../../services/course.service';

@Component({
  selector: 'app-courses-list',
  standalone: true,
  imports: [CommonModule, ReactiveFormsModule],
  templateUrl: './courses-list.component.html',
})
export class CoursesListComponent implements OnInit {
  private readonly fb = inject(FormBuilder);
  private readonly courseService = inject(CourseService);
  readonly auth = inject(AuthService);

  courses: Course[] = [];
  loading = false;
  error: string | null = null;
  showForm = false;
  editingId: number | null = null;

  readonly form = this.fb.nonNullable.group({
    course_name: ['', Validators.required],
    duration: [''],
    fees: [0],
    description: [''],
    status: ['ACTIVE'],
  });

  ngOnInit(): void {
    this.refresh();
  }

  canWrite(): boolean {
    return this.auth.hasRole('ADMIN', 'MARKETING_MANAGER');
  }

  canDelete(): boolean {
    return this.auth.hasRole('ADMIN');
  }

  refresh(): void {
    this.loading = true;
    this.courseService.list().subscribe({
      next: (data) => {
        this.courses = data;
        this.loading = false;
      },
      error: () => {
        this.error = 'Unable to load courses.';
        this.loading = false;
      },
    });
  }

  openCreateForm(): void {
    this.editingId = null;
    this.form.reset({ course_name: '', duration: '', fees: 0, description: '', status: 'ACTIVE' });
    this.showForm = true;
  }

  edit(course: Course): void {
    this.editingId = course.course_id;
    this.form.setValue({
      course_name: course.course_name,
      duration: course.duration ?? '',
      fees: course.fees ?? 0,
      description: course.description ?? '',
      status: course.status,
    });
    this.showForm = true;
  }

  cancel(): void {
    this.showForm = false;
    this.editingId = null;
  }

  save(): void {
    if (this.form.invalid) {
      this.form.markAllAsTouched();
      return;
    }
    const payload = this.form.getRawValue();
    const request = this.editingId
      ? this.courseService.update(this.editingId, payload)
      : this.courseService.create(payload);

    request.subscribe({
      next: () => {
        this.showForm = false;
        this.editingId = null;
        this.refresh();
      },
      error: () => (this.error = 'Unable to save course. Check your permissions and inputs.'),
    });
  }

  remove(course: Course): void {
    if (!confirm(`Delete course "${course.course_name}"?`)) {
      return;
    }
    this.courseService.delete(course.course_id).subscribe({
      next: () => this.refresh(),
      error: () => (this.error = 'Unable to delete course.'),
    });
  }
}

