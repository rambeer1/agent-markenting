import { HttpInterceptorFn, HttpResponse } from '@angular/common/http';
import { delay, of } from 'rxjs';
import { environment } from '../../../environments/environment';
import usersSeed from '../../../mock-data/users.json';
import coursesSeed from '../../../mock-data/courses.json';
import campaignsSeed from '../../../mock-data/campaigns.json';
import leadsSeed from '../../../mock-data/leads.json';
import leadActivitiesSeed from '../../../mock-data/lead-activities.json';
import dashboardSeed from '../../../mock-data/dashboard.json';
import seoTemplate from '../../../mock-data/seo-template.json';
import socialTemplates from '../../../mock-data/social-templates.json';

/**
 * Mock API interceptor - active only when environment.useMockData is true.
 * Lets every feature module be built/tested against realistic JSON fixtures
 * (frontend/src/mock-data) without a running backend. Flip useMockData to
 * false (see environments/environment.ts) to resume calling the real API.
 */

const MOCK_DELAY_MS = 300;

// Mutable in-memory copies so create/update/delete look persisted for the session.
let courses = structuredClone(coursesSeed) as typeof coursesSeed;
let campaigns = structuredClone(campaignsSeed) as typeof campaignsSeed;
let leads = structuredClone(leadsSeed) as typeof leadsSeed;
const leadActivities: Record<string, any[]> = structuredClone(leadActivitiesSeed);

let nextCourseId = Math.max(...courses.map((c) => c.course_id)) + 1;
let nextCampaignId = Math.max(...campaigns.map((c) => c.campaign_id)) + 1;
let nextLeadId = Math.max(...leads.map((l) => l.lead_id)) + 1;
let nextActivityId = 1000;
let nextContentId = 1;
let nextSocialPostId = 1;
let nextSeoBlogId = 1;

function base64UrlEncode(value: unknown): string {
  const json = JSON.stringify(value);
  const base64 = btoa(unescape(encodeURIComponent(json)));
  return base64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}

function createMockToken(email: string, role: string, type: 'access' | 'refresh', ttlSeconds: number): string {
  const header = base64UrlEncode({ alg: 'none', typ: 'JWT' });
  const now = Math.floor(Date.now() / 1000);
  const payload = base64UrlEncode({ sub: email, role, type, iat: now, exp: now + ttlSeconds });
  return `${header}.${payload}.mock-signature`;
}

function fillTemplate<T>(template: T, replacements: Record<string, string>): T {
  let json = JSON.stringify(template);
  for (const [key, value] of Object.entries(replacements)) {
    json = json.split(`{{${key}}}`).join(value);
  }
  return JSON.parse(json) as T;
}

function jsonResponse(status: number, body: unknown) {
  return of(new HttpResponse({ status, body })).pipe(delay(MOCK_DELAY_MS));
}

export const mockInterceptor: HttpInterceptorFn = (req, next) => {
  if (!environment.useMockData) {
    return next(req);
  }

  const url = new URL(req.url, typeof window !== 'undefined' ? window.location.origin : 'http://localhost');
  const path = url.pathname;
  const { method } = req;

  // --- Auth ---
  if (method === 'POST' && path === '/api/v1/auth/login') {
    const { email, password } = req.body as { email: string; password: string };
    const user = usersSeed.find((u) => u.email === email && u.password === password);
    if (!user) {
      return jsonResponse(401, { detail: 'Invalid email or password' });
    }
    return jsonResponse(200, {
      access_token: createMockToken(user.email, user.role, 'access', 60 * 60),
      refresh_token: createMockToken(user.email, user.role, 'refresh', 60 * 60 * 24 * 7),
      token_type: 'bearer',
    });
  }
  if (method === 'POST' && path === '/api/v1/auth/refresh') {
    const claims = JSON.parse(decodeURIComponent(atob((req.body as { refresh_token: string }).refresh_token.split('.')[1])));
    return jsonResponse(200, {
      access_token: createMockToken(claims.sub, claims.role, 'access', 60 * 60),
      refresh_token: createMockToken(claims.sub, claims.role, 'refresh', 60 * 60 * 24 * 7),
      token_type: 'bearer',
    });
  }
  if (method === 'POST' && path === '/api/v1/auth/logout') {
    return jsonResponse(200, {});
  }

  // --- Courses ---
  if (method === 'GET' && path === '/api/v1/courses') {
    return jsonResponse(200, courses);
  }
  if (method === 'POST' && path === '/api/v1/courses') {
    const created = { course_id: nextCourseId++, status: 'ACTIVE', created_date: new Date().toISOString(), ...(req.body as object) };
    courses = [...courses, created as (typeof courses)[number]];
    return jsonResponse(201, created);
  }
  let m = path.match(/^\/api\/v1\/courses\/(\d+)$/);
  if (m && method === 'PUT') {
    const id = Number(m[1]);
    const updated = { ...courses.find((c) => c.course_id === id), ...(req.body as object) };
    courses = courses.map((c) => (c.course_id === id ? (updated as (typeof courses)[number]) : c));
    return jsonResponse(200, updated);
  }
  if (m && method === 'DELETE') {
    const id = Number(m[1]);
    courses = courses.filter((c) => c.course_id !== id);
    return jsonResponse(204, null);
  }

  // --- Campaigns ---
  if (method === 'GET' && path === '/api/v1/campaigns') {
    return jsonResponse(200, campaigns);
  }
  if (method === 'POST' && path === '/api/v1/campaigns') {
    const created = {
      campaign_id: nextCampaignId++,
      status: 'DRAFT',
      created_date: new Date().toISOString(),
      ...(req.body as object),
    };
    campaigns = [...campaigns, created as (typeof campaigns)[number]];
    return jsonResponse(201, created);
  }
  m = path.match(/^\/api\/v1\/campaigns\/(\d+)$/);
  if (m && method === 'PUT') {
    const id = Number(m[1]);
    const updated = { ...campaigns.find((c) => c.campaign_id === id), ...(req.body as object) };
    campaigns = campaigns.map((c) => (c.campaign_id === id ? (updated as (typeof campaigns)[number]) : c));
    return jsonResponse(200, updated);
  }
  m = path.match(/^\/api\/v1\/campaigns\/(\d+)\/launch$/);
  if (m && method === 'POST') {
    return jsonResponse(200, { campaign_id: Number(m[1]), launched: true, ...(req.body as object) });
  }

  // --- Content ---
  if (method === 'POST' && path === '/api/v1/content/generate') {
    return jsonResponse(200, { contentId: nextContentId++, status: 'GENERATED' });
  }

  // --- SEO ---
  if (method === 'POST' && path === '/api/v1/seo/generate') {
    const { keyword } = req.body as { keyword: string };
    const body = fillTemplate(seoTemplate, { keyword });
    return jsonResponse(200, { blog_id: nextSeoBlogId++, title: keyword, keyword, slug: keyword.toLowerCase().replace(/\s+/g, '-'), ...body });
  }

  // --- Social ---
  if (method === 'POST' && path === '/api/v1/social/post/generate') {
    const { platform, topic } = req.body as { platform: string; topic: string };
    const templates = socialTemplates as Record<string, unknown>;
    const template = templates[platform] ?? templates['default'];
    const body = fillTemplate(template, { topic });
    return jsonResponse(200, { ...(body as object), post_id: nextSocialPostId++ });
  }

  // --- Leads ---
  if (method === 'GET' && path === '/api/v1/leads') {
    return jsonResponse(200, leads);
  }
  if (method === 'POST' && path === '/api/v1/leads') {
    const created = {
      lead_id: nextLeadId++,
      lead_score: 0,
      status: 'NEW',
      assigned_to: null,
      created_date: new Date().toISOString(),
      ...(req.body as object),
    };
    leads = [...leads, created as (typeof leads)[number]];
    return jsonResponse(201, created);
  }
  m = path.match(/^\/api\/v1\/leads\/(\d+)$/);
  if (m && method === 'PUT') {
    const id = Number(m[1]);
    const updated = { ...leads.find((l) => l.lead_id === id), ...(req.body as object) };
    leads = leads.map((l) => (l.lead_id === id ? (updated as (typeof leads)[number]) : l));
    return jsonResponse(200, updated);
  }
  m = path.match(/^\/api\/v1\/leads\/(\d+)\/timeline$/);
  if (m && method === 'GET') {
    return jsonResponse(200, leadActivities[m[1]] ?? []);
  }
  m = path.match(/^\/api\/v1\/leads\/(\d+)\/activity$/);
  if (m && method === 'POST') {
    const leadId = Number(m[1]);
    const activity = { activity_id: nextActivityId++, lead_id: leadId, activity_date: new Date().toISOString(), ...(req.body as object) };
    leadActivities[m[1]] = [...(leadActivities[m[1]] ?? []), activity];
    return jsonResponse(201, activity);
  }
  m = path.match(/^\/api\/v1\/leads\/(\d+)\/score$/);
  if (m && method === 'GET') {
    const lead = leads.find((l) => l.lead_id === Number(m![1]));
    const score = lead?.lead_score ?? 0;
    // Mirrors backend/agents/lead_agent/scoring.py:score_band exactly.
    const band = score <= 30 ? 'Cold' : score <= 60 ? 'Warm' : 'Hot';
    return jsonResponse(200, { lead_id: Number(m[1]), lead_score: score, band });
  }

  // --- Analytics ---
  if (method === 'GET' && path === '/api/v1/analytics/dashboard') {
    return jsonResponse(200, dashboardSeed);
  }

  // Unmatched API route in mock mode - fall back to the real backend.
  return next(req);
};

