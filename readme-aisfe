  private readonly http = inject(HttpClient);
  private readonly base = `${environment.apiBaseUrl}/api/v1/auth`;

  login(email: string, password: string): Observable<TokenResponse> {
    return this.http
      .post<TokenResponse>(`${this.base}/login`, { email, password })
      .pipe(tap((res) => this.storeTokens(res)));
  }

  refresh(): Observable<TokenResponse> {
    const refresh_token = this.getRefreshToken();
    if (!refresh_token) {
      return throwError(() => new Error('No refresh token available'));
    }
    return this.http
      .post<TokenResponse>(`${this.base}/refresh`, { refresh_token })
      .pipe(tap((res) => this.storeTokens(res)));
  }

  logout(): void {
    this.http.post(`${this.base}/logout`, {}).subscribe({ error: () => undefined });
    this.clearTokens();
  }

  storeTokens(res: TokenResponse): void {
    localStorage.setItem(ACCESS_KEY, res.access_token);
    localStorage.setItem(REFRESH_KEY, res.refresh_token);
  }

  clearTokens(): void {
    localStorage.removeItem(ACCESS_KEY);
    localStorage.removeItem(REFRESH_KEY);
  }

  getAccessToken(): string | null {
    return localStorage.getItem(ACCESS_KEY);
  }

  getRefreshToken(): string | null {
    return localStorage.getItem(REFRESH_KEY);
  }

  getClaims(): JwtClaims | null {
    const token = this.getAccessToken();
    return token ? decodeJwt(token) : null;
  }

  isAuthenticated(): boolean {
    const claims = this.getClaims();
    return !!claims && claims.exp * 1000 > Date.now();
  }

  getRole(): string | null {
    return this.getClaims()?.role ?? null;
  }

  getEmail(): string | null {
    return this.getClaims()?.sub ?? null;
  }

  hasRole(...roles: string[]): boolean {
    const role = this.getRole();
    return !!role && roles.includes(role);
  }
}

