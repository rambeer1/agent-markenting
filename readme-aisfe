import { Component, OnInit, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';
import { AuthService } from '../../services/auth.service';
import {
  CAMPAIGN_STATUSES,
  CAMPAIGN_TYPES,
  Campaign,
  CampaignService,
} from '../../services/campaign.service';

@Component({
  selector: 'app-campaigns-list',
  standalone: true,
  imports: [CommonModule, ReactiveFormsModule],
  templateUrl: './campaigns-list.component.html',
})
export class CampaignsListComponent implements OnInit {
  private readonly fb = inject(FormBuilder);
  private readonly campaignService = inject(CampaignService);
  readonly auth = inject(AuthService);

  readonly campaignTypes = CAMPAIGN_TYPES;
  readonly campaignStatuses = CAMPAIGN_STATUSES;
  readonly socialPlatforms = ['facebook', 'instagram', 'linkedin', 'youtube', 'whatsapp'];

  campaigns: Campaign[] = [];
  loading = false;
  error: string | null = null;
  message: string | null = null;

  showCreateForm = false;
  editingId: number | null = null;
  launchingId: number | null = null;
  launchResult: Record<string, unknown> | null = null;

  readonly createForm = this.fb.nonNullable.group({
    campaign_name: ['', Validators.required],
    campaign_type: [this.campaignTypes[0], Validators.required],
    start_date: [''],
    end_date: [''],
    budget: [0],
  });

  readonly editForm = this.fb.nonNullable.group({
    status: ['DRAFT'],
    start_date: [''],
    end_date: [''],
    budget: [0],
  });

  readonly launchForm = this.fb.nonNullable.group({
    topic: ['', Validators.required],
    platforms: this.fb.nonNullable.control<string[]>(['instagram', 'facebook']),
  });

  ngOnInit(): void {
    this.refresh();
  }

  canWrite(): boolean {
    return this.auth.hasRole('ADMIN', 'MARKETING_MANAGER');
  }

  refresh(): void {
    this.loading = true;
    this.campaignService.list().subscribe({
      next: (data) => {
        this.campaigns = data;
        this.loading = false;
      },
      error: () => {
        this.error = 'Unable to load campaigns.';
        this.loading = false;
      },
    });
  }

  openCreateForm(): void {
    this.createForm.reset({
      campaign_name: '',
      campaign_type: this.campaignTypes[0],
      start_date: '',
      end_date: '',
      budget: 0,
    });
    this.showCreateForm = true;
  }

  createCampaign(): void {
    if (this.createForm.invalid) {
      this.createForm.markAllAsTouched();
      return;
    }
    this.campaignService.create(this.createForm.getRawValue()).subscribe({
      next: () => {
        this.showCreateForm = false;
        this.refresh();
      },
      error: () => (this.error = 'Unable to create campaign.'),
    });
  }

  editCampaign(campaign: Campaign): void {
    this.editingId = campaign.campaign_id;
    this.editForm.setValue({
      status: campaign.status,
      start_date: campaign.start_date ?? '',
      end_date: campaign.end_date ?? '',
      budget: campaign.budget ?? 0,
    });
  }

  saveEdit(): void {
    if (!this.editingId) {
      return;
    }
    this.campaignService.update(this.editingId, this.editForm.getRawValue()).subscribe({
      next: () => {
        this.editingId = null;
        this.refresh();
      },
      error: () => (this.error = 'Unable to update campaign.'),
    });
  }

  cancelEdit(): void {
    this.editingId = null;
  }

  openLaunch(campaign: Campaign): void {
    this.launchingId = campaign.campaign_id;
    this.launchResult = null;
    this.launchForm.reset({ topic: '', platforms: ['instagram', 'facebook'] });
  }

  togglePlatform(platform: string, checked: boolean): void {
    const current = this.launchForm.controls.platforms.value;
    this.launchForm.controls.platforms.setValue(
      checked ? [...current, platform] : current.filter((p) => p !== platform),
    );
  }

  launch(): void {
    if (!this.launchingId || this.launchForm.invalid) {
      this.launchForm.markAllAsTouched();
      return;
    }
    this.message = null;
    this.error = null;
    this.campaignService.launch(this.launchingId, this.launchForm.getRawValue()).subscribe({
      next: (result) => {
        this.launchResult = result;
        this.message = 'Campaign launched: Content -> Social -> Publish -> Lead Capture workflow triggered.';
        this.refresh();
      },
      error: () => (this.error = 'Unable to launch campaign.'),
    });
  }

  cancelLaunch(): void {
    this.launchingId = null;
    this.launchResult = null;
  }
}

