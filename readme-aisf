import { Component, OnInit, inject, signal } from '@angular/core';
import { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';
import { ContentService } from '../../../core/services/content.service';
import { AdminContentService } from '../../../core/services/admin-content.service';
import { NotificationService } from '../../../core/services/notification.service';
import { ServiceOffering, Testimonial } from '../../../core/models/content.model';

/**
 * Simplified admin content management screen (time-boxed design decision, see
 * TECHNICAL_SPEC.md): demonstrates the CRUD pattern for Service Offerings and
 * Testimonials. Industries, Use Cases, and Case Studies follow the identical pattern
 * against AdminContentService and can be added as additional tabs later.
 */
@Component({
  selector: 'app-content-management',
  standalone: true,
  imports: [ReactiveFormsModule],
  templateUrl: './content-management.html',
})
export class ContentManagement implements OnInit {
  private readonly fb = inject(FormBuilder);
  private readonly contentService = inject(ContentService);
  private readonly adminContentService = inject(AdminContentService);
  private readonly notificationService = inject(NotificationService);

  readonly services = signal<ServiceOffering[]>([]);
  readonly testimonials = signal<Testimonial[]>([]);

  readonly serviceForm = this.fb.group({
    stepNumber: [1, [Validators.required]],
    title: ['', [Validators.required]],
    description: [''],
    deliverables: [''],
    estimatedDuration: [''],
  });

  readonly testimonialForm = this.fb.group({
    clientName: ['', [Validators.required]],
    organization: [''],
    designation: [''],
    testimonialText: ['', [Validators.required]],
    rating: [5, [Validators.required, Validators.min(1), Validators.max(5)]],
  });

  ngOnInit(): void {
    this.loadServices();
    this.loadTestimonials();
  }

  loadServices(): void {
    this.contentService.listServices().subscribe((data) => this.services.set(data));
  }

  loadTestimonials(): void {
    this.contentService.listTestimonials().subscribe((data) => this.testimonials.set(data));
  }

  createService(): void {
    if (this.serviceForm.invalid) {
      this.serviceForm.markAllAsTouched();
      return;
    }
    this.adminContentService.createServiceOffering(this.serviceForm.getRawValue() as Partial<ServiceOffering>).subscribe(() => {
      this.notificationService.show('Service offering created', 'success');
      this.serviceForm.reset({ stepNumber: 1 });
      this.loadServices();
    });
  }

  deleteService(id: number): void {
    this.adminContentService.deleteServiceOffering(id).subscribe(() => {
      this.notificationService.show('Service offering deleted', 'success');
      this.loadServices();
    });
  }

  createTestimonial(): void {
    if (this.testimonialForm.invalid) {
      this.testimonialForm.markAllAsTouched();
      return;
    }
    this.adminContentService.createTestimonial(this.testimonialForm.getRawValue() as Partial<Testimonial>).subscribe(() => {
      this.notificationService.show('Testimonial created', 'success');
      this.testimonialForm.reset({ rating: 5 });
      this.loadTestimonials();
    });
  }

  deleteTestimonial(id: number): void {
    this.adminContentService.deleteTestimonial(id).subscribe(() => {
      this.notificationService.show('Testimonial deleted', 'success');
      this.loadTestimonials();
    });
  }
}
