# Single-container build: packages all 4 Spring Boot services + the Angular frontend +
# nginx into ONE image, so the whole AIS site runs as ONE Cloud Run service. Intended
# for low/medium traffic (a few thousand requests/day) where operational simplicity and
# minimum cost matter more than independent per-service scaling.
#
# Build context is the REPO ROOT (not backend/ or frontend/ individually):
#   docker build -f Dockerfile.cloudrun -t ais-allinone .

FROM maven:3.9-eclipse-temurin-17 AS backend-build
WORKDIR /workspace
COPY backend/pom.xml backend/pom.xml
COPY backend/ais-common backend/ais-common
COPY backend/ais-auth-service backend/ais-auth-service
COPY backend/ais-content-service backend/ais-content-service
COPY backend/ais-consultation-service backend/ais-consultation-service
COPY backend/ais-gateway-service backend/ais-gateway-service
WORKDIR /workspace/backend
RUN mvn -q -DskipTests package

FROM node:22-alpine AS frontend-build
WORKDIR /workspace
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN npx ng build --configuration=cloudrun

FROM eclipse-temurin:17-jre-alpine
RUN apk add --no-cache nginx gettext && mkdir -p /run/nginx
WORKDIR /app

COPY --from=backend-build /workspace/backend/ais-auth-service/target/ais-auth-service-*.jar auth-service.jar
COPY --from=backend-build /workspace/backend/ais-content-service/target/ais-content-service-*.jar content-service.jar
COPY --from=backend-build /workspace/backend/ais-consultation-service/target/ais-consultation-service-*.jar consultation-service.jar
COPY --from=backend-build /workspace/backend/ais-gateway-service/target/ais-gateway-service-*.jar gateway-service.jar
COPY --from=frontend-build /workspace/dist/ais-frontend/browser /usr/share/nginx/html

COPY nginx.cloudrun.conf.template /etc/nginx/templates/default.conf.template
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]
