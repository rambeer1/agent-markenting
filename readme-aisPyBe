# Reduced-footprint stack: 1 Python/FastAPI backend (replaces the former 4 Spring Boot
# services + gateway) + unchanged Angular public + admin site + Postgres.
services:
  postgres:
    image: postgres:16-alpine
    container_name: ais-postgres
    environment:
      POSTGRES_DB: ais_db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    ports:
      - "5432:5432"
    volumes:
      - ais_postgres_data:/var/lib/postgresql/data
      - ./scripts/init-db.sql:/docker-entrypoint-initdb.d/init-db.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 10

  ais-backend:
    build:
      context: ./backend-python
    container_name: ais-backend
    environment:
      DATABASE_URL: postgresql+psycopg2://ais_app_user:ais_app_pass@postgres:5432/ais_db
      JWT_SECRET: ${JWT_SECRET:-local-dev-only-change-me-must-be-32-bytes-minimum}
      CORS_ALLOWED_ORIGINS: http://localhost:4200
    ports:
      - "8080:8080"
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped

  ais-frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: ais-frontend
    ports:
      - "4200:80"
    depends_on:
      - ais-backend
    restart: unless-stopped

volumes:
  ais_postgres_data:

