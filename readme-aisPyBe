import { Component, OnInit, signal } from '@angular/core';
import { DatePipe } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { ConsultationService } from '../../../core/services/consultation.service';
import { ConsultationResponse, LeadStatus } from '../../../core/models/consultation.model';

@Component({
  selector: 'app-leads-management',
  standalone: true,
  imports: [FormsModule, DatePipe],
  templateUrl: './leads-management.html',
})
export class LeadsManagement implements OnInit {
  readonly leads = signal<ConsultationResponse[]>([]);
  readonly totalElements = signal(0);
  readonly page = signal(0);
  readonly pageSize = 10;
  readonly statusFilter = signal<LeadStatus | ''>('');

  readonly statuses: LeadStatus[] = [
    'NEW',
    'CONTACTED',
    'QUALIFIED',
    'PROPOSAL_SENT',
    'NEGOTIATION',
    'WON',
    'LOST',
  ];

  constructor(private readonly consultationService: ConsultationService) {}

  ngOnInit(): void {
    this.load();
  }

  load(): void {
    this.consultationService
      .list(this.page(), this.pageSize, undefined, this.statusFilter() || undefined)
      .subscribe((data) => {
        this.leads.set(data.content);
        this.totalElements.set(data.totalElements);
      });
  }

  onFilterChange(): void {
    this.page.set(0);
    this.load();
  }

  updateStatus(lead: ConsultationResponse, newStatus: LeadStatus): void {
    this.consultationService.updateStatus(lead.id, { status: newStatus }).subscribe(() => {
      this.load();
    });
  }

  nextPage(): void {
    if ((this.page() + 1) * this.pageSize < this.totalElements()) {
      this.page.update((p) => p + 1);
      this.load();
    }
  }

  previousPage(): void {
    if (this.page() > 0) {
      this.page.update((p) => p - 1);
      this.load();
    }
  }

  exportCsv(): void {
    this.consultationService.exportCsv().subscribe((blob) => {
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'consultation-requests.csv';
      link.click();
      window.URL.revokeObjectURL(url);
    });
  }
}

