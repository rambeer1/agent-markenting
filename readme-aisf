<#
.SYNOPSIS
  One-time provisioning of the Cloud SQL for PostgreSQL instance used by the AIS site's
  3 data-owning services (auth, content, consultation). Run this once per environment.

.NOTES
  Requires: gcloud CLI authenticated (`gcloud auth login`) with an active project set.
  Mirrors scripts/init-db.sql (same ais_db database, same 3 per-service DB roles), so
  local Docker Compose and Cloud Run behave the same way.
#>

param(
    [Parameter(Mandatory = $true)][string]$ProjectId,
    [string]$Region = "us-central1",
    [string]$InstanceName = "ais-postgres",
    [string]$DbName = "ais_db",
    [string]$DbTier = "db-f1-micro" # cheapest shared-core tier - plenty for a few thousand requests/day
)

$ErrorActionPreference = "Stop"

gcloud config set project $ProjectId | Out-Null

Write-Host "Enabling required APIs..." -ForegroundColor Cyan
gcloud services enable sqladmin.googleapis.com secretmanager.googleapis.com run.googleapis.com `
    artifactregistry.googleapis.com cloudbuild.googleapis.com

Write-Host "Creating Cloud SQL instance '$InstanceName' (PostgreSQL 16, $DbTier)..." -ForegroundColor Cyan
gcloud sql instances create $InstanceName `
    --database-version=POSTGRES_16 `
    --tier=$DbTier `
    --region=$Region `
    --storage-auto-increase `
    --availability-type=zonal

Write-Host "Creating database '$DbName'..." -ForegroundColor Cyan
gcloud sql databases create $DbName --instance=$InstanceName

function New-SecretIfMissing {
    param([string]$SecretId, [string]$PlainValue)
    $exists = gcloud secrets describe $SecretId --format="value(name)" 2>$null
    if (-not $exists) {
        $PlainValue | gcloud secrets create $SecretId --data-file=- --replication-policy=automatic
        Write-Host "Created secret '$SecretId'." -ForegroundColor Green
    }
    else {
        Write-Host "Secret '$SecretId' already exists, skipping." -ForegroundColor Yellow
    }
}

function New-RandomPassword {
    -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 24 | ForEach-Object { [char]$_ })
}

$roles = @(
    @{ User = "ais_auth_user"; Secret = "ais-auth-db-password" },
    @{ User = "ais_content_user"; Secret = "ais-content-db-password" },
    @{ User = "ais_consultation_user"; Secret = "ais-consultation-db-password" }
)

foreach ($role in $roles) {
    $password = New-RandomPassword
    Write-Host "Creating DB user '$($role.User)'..." -ForegroundColor Cyan
    gcloud sql users create $role.User --instance=$InstanceName --password=$password
    New-SecretIfMissing -SecretId $role.Secret -PlainValue $password
}

# Shared JWT signing secret - used by all 4 services inside the single container.
New-SecretIfMissing -SecretId "ais-jwt-secret" -PlainValue (New-RandomPassword)

$connectionName = gcloud sql instances describe $InstanceName --format="value(connectionName)"
Write-Host ""
Write-Host "Cloud SQL instance connection name: $connectionName" -ForegroundColor Green
Write-Host "Save this value - it is required by deploy-single-cloud-run.ps1 (-CloudSqlConnectionName)." -ForegroundColor Green

Write-Host ""
Write-Host "MANUAL STEP REQUIRED: grant each role CREATE on '$DbName' so Flyway can" -ForegroundColor Yellow
Write-Host "auto-create its schema (auth_schema/content_schema/consultation_schema), e.g.:" -ForegroundColor Yellow
Write-Host "  gcloud sql connect $InstanceName --user=postgres --database=$DbName" -ForegroundColor Yellow
Write-Host "  GRANT ALL PRIVILEGES ON DATABASE $DbName TO ais_auth_user;" -ForegroundColor Yellow
Write-Host "  GRANT ALL PRIVILEGES ON DATABASE $DbName TO ais_content_user;" -ForegroundColor Yellow
Write-Host "  GRANT ALL PRIVILEGES ON DATABASE $DbName TO ais_consultation_user;" -ForegroundColor Yellow
