// Dev-only interceptor: serves the exact same {success, data, message, timestamp} /
// {success, errorCode, message, details, timestamp} envelopes as the real backend, so no
// component code needs to change. Enabled only when environment.useMockData is true
// (see environment.mock.ts + app.config.ts). Query strings are stripped before matching -
// req.url includes them (e.g. "?page=0&size=10"), see angular.md memory note.
function pathOf(req: HttpRequest<unknown>): string {
  return new URL(req.url, 'http://mock.local').pathname.replace(/\/api\/v1/, '');
}

function paramsOf(req: HttpRequest<unknown>): URLSearchParams {
  return new URL(req.url, 'http://mock.local').searchParams;
}

function ok(body: unknown, status = 200): Observable<HttpEvent<unknown>> {
  return of(new HttpResponse({ status, body: { success: true, data: body, message: null, timestamp: new Date().toISOString() } })).pipe(delay(150));
}

function noContent(): Observable<HttpEvent<unknown>> {
  return of(new HttpResponse({ status: 204 })).pipe(delay(150));
}

function fail(status: number, errorCode: string, message: string, details: string[] = []): Observable<HttpEvent<unknown>> {
  // errorInterceptor's catchError() expects a real HttpErrorResponse (matches how
  // HttpXhrBackend reports non-2xx responses), not an HttpResponse with an error status.
  return throwError(
    () =>
      new HttpErrorResponse({
        status,
        error: { success: false, errorCode, message, details, timestamp: new Date().toISOString() },
      })
  );
}

function paged<T>(items: T[], req: HttpRequest<unknown>) {
  const params = paramsOf(req);
  const page = Number(params.get('page') ?? 0);
  const size = Number(params.get('size') ?? 10);
  const start = page * size;
  return {
    content: items.slice(start, start + size),
    totalElements: items.length,
    totalPages: Math.max(Math.ceil(items.length / size), 1),
    page,
    size,
  };
}

function fakeToken(role: string, type: 'access' | 'refresh'): string {
  return `mock-${type}-token-${role}-${Date.now()}`;
}

function loginResponse(username: string, role: string) {
  return {
    accessToken: fakeToken(role, 'access'),
    refreshToken: fakeToken(role, 'refresh'),
    username,
    role,
    expiresInMs: 3_600_000,
  };
}

const DEMO_USERS: Record<string, { password: string; role: string }> = {
  admin: { password: 'admin123', role: 'ADMIN' },
  editor: { password: 'editor123', role: 'EDITOR' },
};

export function mockInterceptor(req: HttpRequest<unknown>, next: HttpHandlerFn): Observable<HttpEvent<unknown>> {
  const path = pathOf(req);
  const method = req.method;
  const body = req.body as Record<string, any> | null;

  // ---- Auth ----
  if (method === 'POST' && path === '/auth/login') {
    const user = DEMO_USERS[body?.['username']];
    if (!user || user.password !== body?.['password']) {
      return fail(401, 'INVALID_CREDENTIALS', 'Invalid username or password');
    }
    return ok(loginResponse(body!['username'], user.role));
  }
  if (method === 'POST' && path === '/auth/refresh') {
    return ok(loginResponse('admin', 'ADMIN'));
  }
  if (method === 'POST' && path === '/auth/logout') {
    return ok(null);
  }

  // ---- Content: public reads ----
  if (method === 'GET' && path === '/content/home') return ok(mockHome);
  if (method === 'GET' && path === '/content/about') return ok(mockCompanyInfo);
  if (method === 'GET' && path === '/content/services') return ok(mockServices);
  if (method === 'GET' && /^\/content\/services\/\d+$/.test(path)) {
    const item = mockServices.find((s) => s.id === Number(path.split('/').pop()));
    return item ? ok(item) : fail(404, 'RESOURCE_NOT_FOUND', 'Service not found');
  }
  if (method === 'GET' && path === '/content/industries') return ok(mockIndustries);
  if (method === 'GET' && /^\/content\/industries\/\d+$/.test(path)) {
    const item = mockIndustries.find((i) => i.id === Number(path.split('/').pop()));
    return item ? ok(item) : fail(404, 'RESOURCE_NOT_FOUND', 'Industry not found');
  }
  if (method === 'GET' && path === '/content/use-cases') {
    const industryId = paramsOf(req).get('industryId');
    const items = industryId ? mockUseCases.filter((u) => u.industryId === Number(industryId)) : mockUseCases;
    return ok(items);
  }
  if (method === 'GET' && /^\/content\/use-cases\/\d+$/.test(path)) {
    const item = mockUseCases.find((u) => u.id === Number(path.split('/').pop()));
    return item ? ok(item) : fail(404, 'RESOURCE_NOT_FOUND', 'Use case not found');
  }
  if (method === 'GET' && path === '/content/case-studies') return ok(mockCaseStudies);
  if (method === 'GET' && /^\/content\/case-studies\/\d+$/.test(path)) {
    const item = mockCaseStudies.find((c) => c.id === Number(path.split('/').pop()));
    return item ? ok(item) : fail(404, 'RESOURCE_NOT_FOUND', 'Case study not found');
  }
  if (method === 'GET' && path === '/content/testimonials') return ok(mockTestimonials);

  if (method === 'POST' && path === '/content/contact') {
    const created = { id: mockIdGenerators.contact(), createdDate: new Date().toISOString(), ...body };
    mockContactMessages.unshift(created as any);
    return ok(created, 201);
  }
  if (method === 'GET' && path === '/content/contact') return ok(paged(mockContactMessages, req));

  // ---- Content: admin CRUD ----
  if (method === 'POST' && path === '/content/admin/services') {
    const created = { id: mockIdGenerators.service(), status: 'ACTIVE', ...body };
    mockServices.push(created as any);
    return ok(created);
  }
  if (method === 'PUT' && /^\/content\/admin\/services\/\d+$/.test(path)) {
    const id = Number(path.split('/').pop());
    const idx = mockServices.findIndex((s) => s.id === id);
    if (idx === -1) return fail(404, 'RESOURCE_NOT_FOUND', 'Service not found');
    mockServices[idx] = { ...mockServices[idx], ...body, id };
    return ok(mockServices[idx]);
  }
  if (method === 'DELETE' && /^\/content\/admin\/services\/\d+$/.test(path)) {
    const id = Number(path.split('/').pop());
    const idx = mockServices.findIndex((s) => s.id === id);
    if (idx !== -1) mockServices.splice(idx, 1);
    return noContent();
  }

  if (method === 'POST' && path === '/content/admin/industries') {
    const created = { id: mockIdGenerators.industry(), ...body };
    mockIndustries.push(created as any);
