import { Component, OnInit, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import { BaseChartDirective } from 'ng2-charts';
import { ChartConfiguration, ChartData } from 'chart.js';
import { DashboardService, DashboardSummary } from '../dashboard/dashboard.service';

@Component({
  selector: 'app-analytics',
  standalone: true,
  imports: [CommonModule, BaseChartDirective],
  templateUrl: './analytics.component.html',
})
export class AnalyticsComponent implements OnInit {
  private readonly dashboardService = inject(DashboardService);

  summary: DashboardSummary | null = null;
  error: string | null = null;

  sourceChartData: ChartData<'pie'> = { labels: [], datasets: [{ data: [] }] };
  funnelChartData: ChartData<'bar'> = { labels: [], datasets: [{ data: [], label: 'Count' }] };

  readonly funnelChartOptions: ChartConfiguration<'bar'>['options'] = {
    responsive: true,
    indexAxis: 'y',
    plugins: { legend: { display: false } },
  };

  ngOnInit(): void {
    this.dashboardService.getSummary().subscribe({
      next: (data) => {
        this.summary = data;
        this.sourceChartData = {
          labels: Object.keys(data.leads_by_source),
          datasets: [{ data: Object.values(data.leads_by_source) }],
        };
        this.funnelChartData = {
          labels: ['Visitors', 'Leads', 'Interested', 'Applications', 'Admissions'],
          datasets: [
            {
              label: 'Admissions Funnel',
              data: [
                data.funnel.visitors,
                data.funnel.leads,
                data.funnel.interested,
                data.funnel.applications,
                data.funnel.admissions,
              ],
              backgroundColor: ['#1e293b', '#334155', '#475569', '#64748b', '#94a3b8'],
            },
          ],
        };
      },
      error: () => (this.error = 'Unable to load analytics data from the backend.'),
    });
  }

  exportCsv(): void {
    if (!this.summary) {
      return;
    }
    const rows: string[][] = [
      ['Metric', 'Value'],
      ['Daily Leads', String(this.summary.daily_leads)],
      ['Monthly Leads', String(this.summary.monthly_leads)],
      ['Top Course', this.summary.top_course ?? ''],
      ['Top Campaign', this.summary.top_campaign ?? ''],
      ['Funnel: Visitors', String(this.summary.funnel.visitors)],
      ['Funnel: Leads', String(this.summary.funnel.leads)],
      ['Funnel: Interested', String(this.summary.funnel.interested)],
      ['Funnel: Applications', String(this.summary.funnel.applications)],
      ['Funnel: Admissions', String(this.summary.funnel.admissions)],
      ...Object.entries(this.summary.leads_by_source).map(([source, count]) => [`Leads by Source: ${source}`, String(count)]),
    ];
    const csv = rows.map((row) => row.map((cell) => `"${cell.replace(/"/g, '""')}"`).join(',')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = 'marketing-agent-analytics.csv';
    link.click();
    URL.revokeObjectURL(url);
  }
}

